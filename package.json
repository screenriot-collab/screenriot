{
  "name": "screenriot",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-sequential.js",
    "dev:all": "node scripts/dev-all.js",
    "dev:down": "docker compose down",
    "dev:api": "pnpm --filter @screenriot/api run dev",
    "health": "node scripts/health-check.js",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "db:generate": "cross-env PRISMA_GENERATE_SKIP_AUTOINSTALL=1 prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "pnpm --filter @screenriot/api run db:seed"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.14.2",
  "devDependencies": {
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "prisma": "^7.0.0"
  },
  "dependencies": {
    "@prisma/client": "^7.0.0"
  }
}
