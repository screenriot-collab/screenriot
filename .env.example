# PostgreSQL (docker-compose postgres service)
POSTGRES_USER=screenriot
POSTGRES_PASSWORD=screenriot_local
POSTGRES_DB=screenriot
POSTGRES_PORT=5432

# Connection string for apps (Prisma, NestJS). Use host 'postgres' when running inside Docker, 'localhost' from host.
DATABASE_URL=postgresql://screenriot:screenriot_local@localhost:5432/screenriot

# MinIO (S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# S3 API (apps/api) — use MinIO credentials above for local
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=screenriot

# From host: S3_ENDPOINT=http://localhost:9000; from container: http://minio:9000

# Auth (apps/api)
JWT_SECRET=change-me-in-production-min-32-chars
GOOGLE_CLIENT_ID=

# Super admin seed (run: pnpm run db:seed). First login in admin panel uses this user.
SUPER_ADMIN_USERNAME=superAdmin
SUPER_ADMIN_PASSWORD=change-me
SUPER_ADMIN_EMAIL=admin@example.com

# API server (apps/api). 3001 so 3000 is free for Next.js (web)
PORT=3001

# Frontend (apps/web) — public API base URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# NextAuth (apps/web). Generate: openssl rand -base64 32
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# --- Mail (apps/api: registration, verification, etc.) ---
# Base URL of the frontend site (used in email links, e.g. verify-email).
FRONTEND_URL=http://localhost:3000

# Base URL of the admin panel (used in admin invite links).
# Local dev (Vite default): http://localhost:3002
ADMIN_URL=http://localhost:3002

# Local dev: MailHog (docker-compose mailhog). No auth.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@screenriot.local

# Optional: MailHog ports when overriding defaults (docker-compose)
# MAILHOG_SMTP_PORT=1025
# MAILHOG_WEB_PORT=8025

# Production: set MAIL_HOST/MAIL_PORT/MAIL_USER/MAIL_PASSWORD to your SMTP (SendGrid, Mailgun, etc.) and FRONTEND_URL to your domain.

# --- Stripe (apps/api: donations, apps/web: checkout) ---
# Get from Stripe Dashboard → Developers → API keys (use Test mode for local).
# Secret key: never commit real value; use in .env only.
STRIPE_SECRET_KEY=
# Publishable key: used by frontend (Next.js). Safe to expose in client.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret: for local dev run `stripe listen --forward-to localhost:3001/donations/webhook` and paste the whsec_... here.
STRIPE_WEBHOOK_SECRET=
