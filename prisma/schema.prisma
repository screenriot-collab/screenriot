generator client {
  provider = "prisma-client-js"
  output   = "../apps/api/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  passwordHash          String?
  role                  UserRole               @default(fan)
  stripeCustomerId      String?                @map("stripe_customer_id")
  agreementSignedAt     DateTime?              @map("agreement_signed_at")
  emailVerifiedAt       DateTime?              @map("email_verified_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  username              String?                @unique
  firstName             String?                @map("first_name")
  lastName              String?                @map("last_name")
  displayName           String?                @map("display_name")
  phone                 String?
  dateOfBirth           DateTime?              @map("date_of_birth") @db.Date
  country               String?
  city                  String?
  bio                   String?
  website               String?
  socialTwitter         String?                @map("social_twitter")
  socialInstagram       String?                @map("social_instagram")
  socialLinkedin        String?                @map("social_linkedin")
  avatarKey             String?                @map("avatar_key")
  lastEditedById        String?                @map("last_edited_by")
  lastEditedBy          User?                  @relation("UserLastEditedBy", fields: [lastEditedById], references: [id])
  usersEdited           User[]                 @relation("UserLastEditedBy")
  accounts              Account[]
  donations             Donation[]
  approvedApplications  FilmmakerApplication[] @relation("ApprovedBy")
  filmmakerApplications FilmmakerApplication[]
  films                 Film[]
  filmsReviewed         Film[]                 @relation("FilmLastReviewedBy")
  payouts               Payout[]
  filmmakerProfile      FilmmakerProfile?
  verification          UserVerification?
  verificationsReviewed UserVerification[]     @relation("VerificationReviewedBy")
  castingVotes          FilmCastingVote[]
  pledgeVotes           FilmPledgeVote[]
  contributions         FilmContribution[]

  @@map("users")
}

model FilmmakerProfile {
  id                String   @id @default(cuid())
  userId            String   @unique @map("user_id")
  productionCompany String?  @map("production_company")
  imdbUrl           String?  @map("imdb_url")
  statement         String?
  yearsOfExperience Int?     @map("years_of_experience")
  specialization    String[] @default([])
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("filmmaker_profiles")
}

model UserVerification {
  id            String               @id @default(cuid())
  userId        String               @unique @map("user_id")
  status        VerificationStatus   @default(not_started)
  adminFeedback String?              @map("admin_feedback")
  submittedAt   DateTime?            @map("submitted_at")
  reviewedAt    DateTime?            @map("reviewed_at")
  reviewedById  String?              @map("reviewed_by")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy    User?                @relation("VerificationReviewedBy", fields: [reviewedById], references: [id])
  documents     VerificationDocument[]

  @@map("user_verifications")
}

model VerificationDocument {
  id             String              @id @default(cuid())
  verificationId String              @map("verification_id")
  type           VerificationDocType
  fileKey        String              @map("file_key")
  fileName       String              @map("file_name")
  fileSize       Int                 @map("file_size")
  status         DocReviewStatus     @default(uploaded)
  adminComment   String?             @map("admin_comment")
  uploadedAt     DateTime            @default(now()) @map("uploaded_at")
  verification   UserVerification    @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([verificationId])
  @@map("verification_documents")
}

model Account {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model FilmmakerApplication {
  id             String            @id @default(cuid())
  userId         String            @map("user_id")
  status         ApplicationStatus @default(pending)
  attachmentKeys Json?             @map("attachment_keys")
  approvedById   String?           @map("approved_by")
  approvedAt     DateTime?         @map("approved_at")
  rejectedAt     DateTime?         @map("rejected_at")
  managerComment String?           @map("manager_comment")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  approvedBy     User?             @relation("ApprovedBy", fields: [approvedById], references: [id])
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("filmmaker_applications")
}

model Film {
  id                String        @id @default(cuid())
  filmmakerId       String        @map("filmmaker_id")
  title             String
  description       String?
  goalAmount        Decimal       @map("goal_amount") @db.Decimal(12, 2)
  currentAmount     Decimal       @default(0) @map("current_amount") @db.Decimal(12, 2)
  status            FilmStatus    @default(draft)
  deadline          DateTime?     @db.Timestamptz(6)
  posterKey         String?       @map("poster_key")
  posterUrl         String?       @map("poster_url")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  chainOfTitleKey   String?       @map("chain_of_title_key")
  directorName      String?       @map("director_name")
  genre             String?
  logline           String?
  rating            String?
  reviewComments    Json?         @map("review_comments")
  reviewStatus      ReviewStatus? @map("review_status")
  runtime           String?
  screenplayKey     String?       @map("screenplay_key")
  slug              String        @unique @default(cuid())
  step3             Json?
  step4             Json?
  submissionFeePaid Boolean       @default(false) @map("submission_fee_paid")
  synopsis          String?
  videoKey          String?       @map("video_key")
  lastReviewedById  String?       @map("last_reviewed_by")
  pageContent       Json?         @map("page_content")
  pagePublished     Boolean       @default(false) @map("page_published")
  trendingText      String?       @map("trending_text")
  cachedVotesCount  Int?          @default(0) @map("cached_votes_count")
  cachedAverageScore Decimal?     @map("cached_average_score") @db.Decimal(4, 2)
  donations         Donation[]
  filmmaker         User          @relation(fields: [filmmakerId], references: [id], onDelete: Cascade)
  lastReviewedBy    User?         @relation("FilmLastReviewedBy", fields: [lastReviewedById], references: [id])
  payouts           Payout[]
  castingVotes      FilmCastingVote[]
  pledgeVotes       FilmPledgeVote[]
  contributions     FilmContribution[]

  @@index([filmmakerId])
  @@index([lastReviewedById])
  @@index([status])
  @@index([slug])
  @@map("films")
}

model Donation {
  id              String         @id @default(cuid())
  userId          String         @map("user_id")
  filmId          String         @map("film_id")
  amount          Decimal        @db.Decimal(12, 2)
  stripePaymentId String?        @map("stripe_payment_id")
  status          DonationStatus @default(pending)
  createdAt       DateTime       @default(now()) @map("created_at")
  film            Film           @relation(fields: [filmId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts         Payout[]

  @@index([userId])
  @@index([filmId])
  @@map("donations")
}

model FilmCastingVote {
  id        String   @id @default(cuid())
  filmId    String   @map("film_id")
  userId    String   @map("user_id")
  optionId  String   @map("option_id")
  createdAt DateTime @default(now()) @map("created_at")

  film Film @relation(fields: [filmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([filmId, userId])
  @@index([filmId])
  @@index([userId])
  @@map("film_casting_votes")
}

model FilmPledgeVote {
  id        String   @id @default(cuid())
  filmId    String   @map("film_id")
  userId    String   @map("user_id")
  scores    Json     @map("scores")
  createdAt DateTime @default(now()) @map("created_at")

  film Film @relation(fields: [filmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([filmId, userId])
  @@index([filmId])
  @@index([userId])
  @@map("film_pledge_votes")
}

model Payout {
  id         String       @id @default(cuid())
  donationId String?      @map("donation_id")
  userId     String       @map("user_id")
  filmId     String       @map("film_id")
  amount     Decimal      @db.Decimal(12, 2)
  status     PayoutStatus @default(pending)
  paidAt     DateTime?    @map("paid_at") @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @map("created_at")
  donation   Donation?    @relation(fields: [donationId], references: [id])
  film       Film         @relation(fields: [filmId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([donationId])
  @@index([userId])
  @@index([filmId])
  @@map("payouts")
}

enum UserRole {
  fan
  filmmaker
  super_admin
  admin
  manager
}

enum ApplicationStatus {
  pending
  approved
  rejected
}

enum FilmStatus {
  draft
  pending_approval
  approved
  rejected
  fundraising
  funded
  closed
}

enum DonationStatus {
  pending
  completed
  failed
}

enum PayoutStatus {
  pending
  paid
  failed
}

enum ReviewStatus {
  action_required
  no_action
  changes_submitted
}

enum VerificationStatus {
  not_started
  pending
  verified
  rejected
}

enum VerificationDocType {
  government_id
  proof_of_address
  selfie_with_id
  business_registration
  guild_membership
  festival_certificate
  credits_documentation
}

enum DocReviewStatus {
  uploaded
  approved
  rejected
}

model FilmContribution {
  id           String             @id @default(cuid())
  number       String             @unique
  filmId       String             @map("film_id")
  userId       String             @map("user_id")
  status       ContributionStatus @default(pending)
  changes      Json
  comment      String?
  adminComment String?            @map("admin_comment")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  processedAt  DateTime?          @map("processed_at")

  film Film @relation(fields: [filmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([filmId])
  @@index([userId])
  @@map("film_contributions")
}

enum ContributionStatus {
  pending
  approved
  rejected
}
